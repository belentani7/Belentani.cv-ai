# Database (configure only if you enable Prisma-backed features)
DATABASE_URL=
DIRECT_URL=

# SDK / app configuration (do not commit real keys)
OPENROUTER_API_KEY=
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# REQUIRED to enable /api/cv/generate, /api/cover-letter, /api/chat, /api/study-tools.
# The server intentionally returns 503 (without invoking AI) when either is missing.
# Configure as protected server environment variables in the deployment provider.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# An existing Upstash integration may use these names. They are NOT read
# directly by the current API routes, so configure the KV_REST_API_* names above.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
