# Server-only environment template for Belentani CV Studio.
# Copy to .env.local for local development; never commit .env.local or real credentials.
# Set both variables in your deployment's encrypted environment/secret manager.
# These are required by the protected CV and cover-letter AI endpoints.
# Leave values empty in version control. Keep production and preview credentials separate.
KV_REST_API_URL=
KV_REST_API_TOKEN=
