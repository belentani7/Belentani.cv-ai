    "@types/node": "26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.4.5",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-environment-node": "^30.5.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
