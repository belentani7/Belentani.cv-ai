{
  "packageManager": "pnpm@9.15.0",
  "name": "belentani-cv-studio",
  "version": "0.2.1",
  "private": false,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "node scripts/db-generate.mjs && next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "test": "jest",
    "test:gates": "node --test tests/next-security-headers.test.mjs tests/security-release-audit.test.mjs scripts/check-cv-identity.mjs",
    "test:e2e": "node --test tests/e2e-happy-path.test.mjs",
    "audit:repo": "node scripts/forge-audit.mjs",
    "audit:web": "node scripts/a11y-perf-audit.mjs",
    "db:push": "prisma db push",
    "db:generate": "node scripts/db-generate.mjs",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "typecheck": "tsc --noEmit",
    "quality:check": "pnpm run typecheck && pnpm run lint && pnpm exec jest --coverage --runInBand && pnpm run test:gates && pnpm run build"
  },
  "dependencies": {
